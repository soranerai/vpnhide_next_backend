+bool vpnhide_should_hide_dev(const struct net_device *dev) {
+  if (!dev)
+    return false;
+
+  if (!is_hook_active(HOOK_RTNL_FILL, from_kuid(&init_user_ns, current_uid())))
+    return false;
+
+  if (!is_target_uid())
+    return false;
+
+  return is_active_vpn_ifname(dev->name);
