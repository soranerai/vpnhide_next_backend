From: vpnhide <vpnhide@intree>
Subject: [PATCH] fs: readdir, namei, proc_sysctl — VPN path hiding

readdir.c  — filter VPN interface names from getdents64 results
namei.c    — return ENOENT for path lookups under VPN netdev sysfs dirs
proc_sysctl.c — hide VPN interface sysctl subtree

diff --git a/fs/readdir.c b/fs/readdir.c
--- a/fs/readdir.c
+++ b/fs/readdir.c
@@ -19,6 +19,7 @@
 #include <linux/fs.h>
 #include <linux/dirent.h>
 #include <linux/uaccess.h>
+#include <linux/vpnhide.h>
 #include <asm/unistd.h>

 int iterate_dir(struct file *file, struct dir_context *ctx)
@@ -350,6 +353,7 @@ SYSCALL_DEFINE3(getdents64, unsigned int, fd,
 		goto out;

 	error = iterate_dir(f.file, &buf.ctx);
 	if (error >= 0)
 		error = buf.error;
+	error = vpnhide_getdents64(fd, dirent, count, error);
 out:
diff --git a/fs/namei.c b/fs/namei.c
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -39,6 +39,7 @@
 #include <linux/bitops.h>
 #include <linux/init_task.h>
 #include <linux/uaccess.h>
+#include <linux/vpnhide.h>
 #include "internal.h"
 #include "mount.h"

@@ -1510,6 +1513,11 @@ static struct dentry *lookup_dcache(const struct qstr *name,
 		}
 	}
+
+	/* Hide VPN netdev entries from /proc/sys/net/ and /sys/class/net/ */
+	if (dentry && !IS_ERR(dentry) &&
+	    vpnhide_should_hide_path(&(struct path){.dentry = dentry})) {
+		dput(dentry);
+		return ERR_PTR(-ENOENT);
+	}
+
 	return dentry;
 }

diff --git a/fs/proc/proc_sysctl.c b/fs/proc/proc_sysctl.c
--- a/fs/proc/proc_sysctl.c
+++ b/fs/proc/proc_sysctl.c
@@ -20,6 +20,7 @@
 #include <linux/security.h>
 #include <linux/slab.h>
 #include <linux/uaccess.h>
+#include <linux/vpnhide.h>
 #include "internal.h"

 static const struct dentry_operations proc_sys_dentry_operations;
@@ -225,6 +228,12 @@ static struct dentry *proc_sys_lookup(struct inode *dir, struct dentry *dentry,
 	struct ctl_table_header *head;
 	struct ctl_table *p;

+	/* Intercept lookups for VPN interface names under /proc/sys/net/ */
+	if (vpnhide_filter_sysctl(dir, dentry->d_name.name,
+				  dentry->d_name.len))
+		return ERR_PTR(-ENOENT);
+
 	spin_lock(&sysctl_lock);
 	p = find_in_table(head, &dentry->d_name);
