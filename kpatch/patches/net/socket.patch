From: vpnhide <vpnhide@intree>
Subject: [PATCH] net: socket — setsockopt/getsockopt/connect/bind/getname hooks

Hooks are called at precisely the right point in the socket call path:
- setsockopt: AFTER sockfd_lookup_light() so sock is valid
- getsockopt: AFTER processing so returned values can be spoofed
- connect/bind: AFTER sock_from_file/sockfd_lookup so sock is valid
- getname: AFTER inet_getname fills the buffer, modify in-kernel before
  copy_to_user

diff --git a/net/socket.c b/net/socket.c
--- a/net/socket.c
+++ b/net/socket.c
@@ -77,6 +77,7 @@
 #include <linux/security.h>
 #include <linux/syscalls.h>
 #include <linux/compat.h>
+#include <linux/vpnhide.h>
 #include <linux/kmod.h>
 #include <linux/audit.h>
 #include <linux/wireless.h>
@@ -1661,6 +1664,11 @@ int __sys_bind(int fd, struct sockaddr __user *umyaddr, int addrlen)
 		if (!err) {
 			struct sockaddr_storage address;
 			err = move_addr_to_kernel(umyaddr, addrlen, &address);
+			if (!err) {
+				err = vpnhide_bind_pre(sock,
+					(struct sockaddr *)&address, addrlen);
+			}
 			if (!err)
 				err = security_socket_bind(sock,
 						   (struct sockaddr *)&address,
@@ -1881,13 +1881,15 @@ int __sys_connect_file(struct file *file, struct sockaddr_storage *address,
 		       int addrlen, int file_flags)
 {
 	struct socket *sock;
+	int err;

 	sock = sock_from_file(file, &err);
 	if (!sock)
 		goto out_err;

+	err = vpnhide_connect_pre(sock, (struct sockaddr *)address, addrlen);
+	if (err)
+		goto out_err;
+
 	err = security_socket_connect(sock, (struct sockaddr *)address, addrlen);
@@ -1941,6 +1954,14 @@ int __sys_getsockname(int fd, struct sockaddr __user *usockaddr,
 	err = sock->ops->getname(sock, (struct sockaddr *)&address, 0);
 	if (err < 0)
 		goto out_put;
+
+	vpnhide_getname_post(sock, (struct sockaddr *)&address, 0);
+
 	err = move_addr_to_user(&address, err, usockaddr, usockaddr_len);

 out_put:
@@ -2078,6 +2094,16 @@ int __sys_setsockopt(int fd, int level, int optname, char __user *optval,
 	sock = sockfd_lookup_light(fd, &err, &fput_needed);
 	if (sock != NULL) {

+		{
+			sockptr_t _sp = USER_SOCKPTR(optval);
+			int _ret = vpnhide_setsockopt(sock, level, optname,
+						      _sp, optlen);
+			if (_ret) {
+				fput_light(sock->file, fput_needed);
+				return _ret;
+			}
+		}
+
 		err = security_socket_setsockopt(sock, level, optname);
@@ -2115,6 +2131,8 @@ int __sys_getsockopt(int fd, int level, int optname, char __user *optval,

 	if (!err && level == SOL_SOCKET)
 		err = sock_getsockopt(sock, level, optname, optval, optlen);
+
+	vpnhide_getsockopt_post(sock, level, optname, optval, optlen);

 	fput_light(sock->file, fput_needed);
 out:
