From: vpnhide <vpnhide@intree>
Subject: [PATCH] net: dev_ioctl — block SIOCG* and filter SIOCGIFCONF for VPN ifaces

Two ioctl vectors that bypass netlink hiding:
- SIOCGIFCONF enumerates ALL interfaces into an ifreq array (used by
  ifconfig, legacy apps). vpnhide_filter_ifconf() compacts the result
  in-place, removing VPN entries and adjusting ifc_len.
- Per-interface SIOCG* commands (SIOCGIFFLAGS, SIOCGIFADDR, etc.) name
  a specific interface. vpnhide_ioctl_ifname_block() returns -ENODEV
  before dev_ifsioc() is entered.

diff --git a/net/core/dev_ioctl.c b/net/core/dev_ioctl.c
--- a/net/core/dev_ioctl.c
+++ b/net/core/dev_ioctl.c
@@ -5,6 +5,7 @@
 #include <linux/netdevice.h>
 #include <linux/net.h>
 #include <linux/if_arp.h>
+#include <linux/vpnhide.h>
 #include <net/net_namespace.h>

 /*
@@ -270,6 +271,10 @@ int dev_ioctl(struct net *net, unsigned int cmd, struct ifreq *ifr,
 	int ret;

 	switch (cmd) {
+	/* Filter SIOCGIFCONF before returning to userspace */
 	case SIOCGIFCONF:
 		ret = dev_ifconf(net, data);
+		if (!ret)
+			vpnhide_filter_ifconf(data);
 		break;

 	case SIOCGIFFLAGS:
@@ -284,6 +289,11 @@ int dev_ioctl(struct net *net, unsigned int cmd, struct ifreq *ifr,
 	case SIOCGIFMAP:
 	case SIOCGIFINDEX:
 	case SIOCGIFTXQLEN:
+		/* Block per-interface SIOCG* for hidden VPN interfaces */
+		if (ifr && vpnhide_ioctl_ifname_block(ifr->ifr_name)) {
+			ret = -ENODEV;
+			break;
+		}
+		fallthrough;
 	default:
 		ret = dev_ifsioc(net, ifr, data, cmd);
 	}
