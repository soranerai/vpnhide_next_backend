From: vpnhide <vpnhide@intree>
Subject: [PATCH] net: rtnetlink, devinet, addrconf — early-return VPN hiding

Replace post-trim kretprobe approach with early-return at the top of
each fill function and dump loop. When the target interface is VPN, we
return 0 / skip iteration before any netlink message is built.

diff --git a/net/core/rtnetlink.c b/net/core/rtnetlink.c
--- a/net/core/rtnetlink.c
+++ b/net/core/rtnetlink.c
@@ -49,6 +49,7 @@
 #include <net/udp.h>
 #include <net/tcp.h>
 #include <net/sock.h>
+#include <linux/vpnhide.h>
 #include <net/pkt_sched.h>
 #include <net/fib_rules.h>
 #include <net/rtnetlink.h>
@@ -1800,6 +1800,9 @@ static int rtnl_fill_ifinfo(struct sk_buff *skb, struct ifinfomsg *ifm,
 			    const struct net_device *dev, int type,
 			    u32 pid, u32 seq, unsigned int flags, u32 ext_filter_mask)
 {
+	if (unlikely(vpnhide_skip_iflink(skb, dev)))
+		return 0;
+
 	struct nlmsghdr  *nlh;
 	struct ifinfomsg *ifm_out;

@@ -2127,6 +2130,9 @@ static int rtnl_dump_ifinfo(struct sk_buff *skb, struct netlink_callback *cb)
 		idx = 0;
 		head = &tgt_net->dev_index_head[h];
 		hlist_for_each_entry(dev, head, index_hlist) {
+			if (unlikely(vpnhide_skip_iflink(skb, dev)))
+				goto cont;
+
 			if (link_dump_filtered(dev, master_idx, kind_ops))
 				goto cont;
 			if (idx < s_idx)
diff --git a/net/ipv4/devinet.c b/net/ipv4/devinet.c
--- a/net/ipv4/devinet.c
+++ b/net/ipv4/devinet.c
@@ -58,6 +58,7 @@
 #include <net/ip.h>
 #include <net/route.h>
 #include <net/ip_fib.h>
+#include <linux/vpnhide.h>
 #include <net/rtnetlink.h>
 #include <net/net_namespace.h>
 #include <net/addrconf.h>
@@ -1630,6 +1633,9 @@ static int inet_fill_ifaddr(struct sk_buff *skb, struct in_ifaddr *ifa,
 			    u32 pid, u32 seq, int event,
 			    unsigned int flags)
 {
+	if (unlikely(vpnhide_skip_inet_ifaddr(skb, ifa)))
+		return 0;
+
 	struct ifaddrmsg *ifm;
 	struct nlmsghdr  *nlh;

@@ -1852,6 +1858,9 @@ static int inet_dump_ifaddr(struct sk_buff *skb, struct netlink_callback *cb)
 		cb->seq = atomic_read(&tgt_net->ipv4.dev_addr_genid) ^
 			  tgt_net->dev_base_seq;
 		hlist_for_each_entry_rcu(dev, head, index_hlist) {
+			if (unlikely(vpnhide_skip_iflink(skb, dev)))
+				goto cont;
+
 			if (idx < s_idx)
 				goto cont;
 			if (h > s_h || idx > s_idx)
diff --git a/net/ipv6/addrconf.c b/net/ipv6/addrconf.c
--- a/net/ipv6/addrconf.c
+++ b/net/ipv6/addrconf.c
@@ -46,6 +46,7 @@
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
 #include <linux/export.h>
+#include <linux/vpnhide.h>
 #include <net/sock.h>
 #include <net/snmp.h>
 #include <net/ipv6.h>
@@ -5100,6 +5103,9 @@ static int inet6_fill_ifaddr(struct sk_buff *skb, struct inet6_ifaddr *ifa,
 			     u32 portid, u32 seq, int event,
 			     unsigned int flags)
 {
+	if (unlikely(vpnhide_skip_inet6_ifaddr(skb, ifa)))
+		return 0;
+
 	struct nlmsghdr  *nlh;
 	struct ifaddrmsg *ifm;

@@ -5252,6 +5258,9 @@ static int if6_seq_show(struct seq_file *seq, void *v)
 	struct inet6_ifaddr *ifp = (struct inet6_ifaddr *)v;
+
+	if (unlikely(vpnhide_skip_if6_seq(seq, ifp)))
+		return 0;
+
 	seq_printf(seq, "%pi6 %02x %02x %02x %02x %8s\n",
 		   &ifp->addr,
 		   ifp->prefix_len,
 		   ifp->idev->if_flags,
