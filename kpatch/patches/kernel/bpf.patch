From: vpnhide <vpnhide@intree>
Subject: [PATCH] kernel: bpf/syscall — zero BPF map stats for VPN interfaces

Called after map_lookup_elem and bpf_map_do_batch complete their
lookup. Zeroes entries whose key names a VPN interface or target UID,
preventing userspace from reading real VPN traffic accounting.

diff --git a/kernel/bpf/syscall.c b/kernel/bpf/syscall.c
--- a/kernel/bpf/syscall.c
+++ b/kernel/bpf/syscall.c
@@ -5,6 +5,7 @@
 #include <linux/bpf_trace.h>
 #include <linux/bpf_lirc.h>
 #include <linux/bpf_verifier.h>
+#include <linux/vpnhide.h>
 #include <linux/btf.h>
 #include <linux/syscalls.h>
 #include <linux/slab.h>
@@ -1059,6 +1062,7 @@ static int map_lookup_elem(union bpf_attr *attr)
 	err = bpf_map_copy_value(map, key, value, attr->flags);
 	if (err)
 		goto free_value;
+	vpnhide_bpf_lookup_elem(map, key, value);
 	err = copy_map_value_to_user(map, uvalue, value, uattr);

@@ -4032,6 +4036,8 @@ static int bpf_map_do_batch(const union bpf_attr *attr,
 		BPF_DO_BATCH(map->ops->map_update_batch);
 	else
 		BPF_DO_BATCH(map->ops->map_delete_batch);
+	if (cmd == BPF_MAP_LOOKUP_BATCH)
+		vpnhide_bpf_lookup_batch(map, attr, uattr);
+
 err_put:
 	if (has_write)
 		bpf_map_write_active_dec(map);
