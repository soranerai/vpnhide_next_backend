 #include <net/ip_tunnels.h>
 #include <linux/indirect_call_wrapper.h>

@@ -990,6 +994,27 @@ static int fib_nl_fill_rule(struct sk_buff *skb, struct fib_rule *rule,
 {
 	struct nlmsghdr *nlh;
 	struct fib_rule_hdr *frh;
+#ifdef CONFIG_VPNHIDE
+	if (is_target_uid()) {
+		/* Hide rules referencing a VPN interface by name */
+		if ((rule->iifname[0] && vpnhide_should_hide_ifname(rule->iifname)) ||
+		    (rule->oifname[0] && vpnhide_should_hide_ifname(rule->oifname)))
+			return 0;
+		/* Hide UID split-routing rules: any rule with a uid_range that
+		 * covers app UIDs (>= 10000) pointing at a non-main/default/local
+		 * table — this is the VPN per-app routing fingerprint. */
+		{
+			uid_t _start = from_kuid(&init_user_ns, rule->uid_range.start);
+			uid_t _end   = from_kuid(&init_user_ns, rule->uid_range.end);
+			if (_end != (uid_t)~0 &&
+			    (_start >= 10000 || _end >= 10000 ||
+			     is_target_uid_val(_start) || is_target_uid_val(_end)) &&
+			    rule->table != 253 && rule->table != 254 &&
+			    rule->table != 255 && rule->table > 100)
+				return 0;
+		}
+	}
+#endif

 	nlh = nlmsg_put(skb, pid, seq, type, sizeof(*frh), flags);
 	if (nlh == NULL)
