# Kconfig fragment for kpatch QEMU tests.
# Extends kmod/test/qemu.config so the VPNHide
# subsystem is compiled directly into the Image (no .ko loading needed).
#
# All virtio / PL011 / DUMMY / initramfs options come from kmod/test/qemu.config
# (included by build-kernel.sh via merge_config.sh); this fragment only adds
# the kpatch-specific config.

# ---- same infrastructure as kmod ----
# virtio transport + block/net
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y

# PL011 serial = the QEMU virt console (ttyAMA0)
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# initramfs as rootfs + devtmpfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y

# dummy netdev for vpn0
CONFIG_DUMMY=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FIFO=y
CONFIG_NET_SCH_PRIO=y

# no module signing / symbol trimming needed
# CONFIG_MODULE_SIG is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set

# skip BTF (same as kmod — avoids resolve_btfids failures on some tips)
# CONFIG_DEBUG_INFO_BTF is not set

# ---- kpatch-specific ----
# Bake VPNHide into the kernel; the misc device /dev/vpnhide_ctrl appears
# at boot without any insmod. This is the flag patch_kernel.py guards on.
CONFIG_VPNHIDE=y

# Explicit dependencies for the legacy QEMU profiles (4.19/5.4).
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECURITY=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
